# Canonical public origin used by metadata, sitemap, robots, and structured data.
# Vercel production deployments can omit this because VERCEL_PROJECT_PRODUCTION_URL is detected.
SITE_URL=https://your-production-domain.example
# Public build identifier included in privacy-safe Web Vitals events; set it to
# the immutable candidate SHA or release identifier in Preview/Production.
NEXT_PUBLIC_APP_VERSION=0.1.0

# Dataset-level fallback used only when indexed explorers are incomplete.
# https://admin.moralis.com/register
MORALIS_API_KEY=YourMoralisApiKeyHere
# Hard scan-level safety limit, partitioned across chains that need fallback.
MORALIS_MAX_FALLBACK_CU_PER_SCAN=3000
MORALIS_MAX_PAGES_PER_DATASET=100

# Unified Etherscan V2 provider. One key is used across supported chains.
# https://etherscan.io/apis
ETHERSCAN_API_KEY=YourEtherscanApiKeyHere
# Set true only when this key has paid access to Base and Optimism.
ETHERSCAN_ENABLE_PAID_CHAINS=false

# Optional Blockscout Pro fallback for supported chains.
# https://dev.blockscout.com
BLOCKSCOUT_API_KEY=YourBlockscoutApiKeyHere

# Historical and current token pricing.
# https://www.coingecko.com/en/api
COINGECKO_API_KEY=YourCoinGeckoApiKeyHere

# Optional shared cache and deployment-wide scan protection.
# Create a free Upstash Redis database and copy its REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SHARED_SCAN_DAILY_LIMIT=500
SHARED_BATCH_DAILY_LIMIT=100

# Optional comma-separated Etherscan-compatible indexed-history fallbacks.
EXPLORER_FALLBACK_URLS_1=
EXPLORER_FALLBACK_URLS_10=
EXPLORER_FALLBACK_URLS_8453=
EXPLORER_FALLBACK_URLS_42161=

# Optional comma-separated JSON-RPC mirrors. Built-in RPCs remain enabled.
RPC_FALLBACK_URLS_1=
RPC_FALLBACK_URLS_10=
RPC_FALLBACK_URLS_8453=
RPC_FALLBACK_URLS_42161=
