    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.5.26",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.19",
